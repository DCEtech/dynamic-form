      },
      "direccion": {
        "label": "Full Address *",
        "tooltip": "Full address including street, number, floor, etc.",
        "placeholder": "e.g., 123 Main St, 2nd Floor",
        "error": "Please enter the full address."
      },
      "cp": {
        "label": "Postal Code *",
        "tooltip": "5-digit postal code",
        "placeholder": "e.g., 28001",
        "error": "Postal code must be 5 digits."
      },
      "provincia": {
        "label": "Province *",
        "tooltip": "Select the province where the company is located",
        "default_option": "Select a province",
        "error": "Please select a province."
      },
      "telefono": {
        "label": "Phone *",
        "tooltip": "Contact phone (format: +34 XXX XXX XXX)",
        "placeholder": "e.g., +34 912 345 678",
        "error": "Invalid phone format. Use +34 XXX XXX XXX."
      },
      "email": {
        "label": "Corporate Email *",
        "tooltip": "Primary company email address",
        "placeholder": "e.g., info@company.com",
        "error": "Please enter a valid email."
      },
      "web": {
        "label": "Website",
        "tooltip": "Company website URL (optional)",
        "placeholder": "e.g., https://www.company.com",
        "error": "Please enter a valid URL."
      },
      "banco": {
        "label": "Bank Name",
        "tooltip": "Name of the banking institution",
        "placeholder": "e.g., Santander Bank"
      },
      "bic": {
        "label": "BIC/SWIFT",
        "tooltip": "International bank identifier. Found in your banking app (Account details) or statements. 8-11 characters",
