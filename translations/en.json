        "error": "Invalid BIC/SWIFT format."
      },
      "iban": {
        "label": "Bank Account (IBAN)",
        "tooltip": "Account number in IBAN format (ES + 22 digits)",
        "placeholder": "e.g., ES91 2100 0418 4502 0005 1332",
        "error": "Invalid Spanish IBAN format."
      },
      "sepa": {
        "label": "SEPA Creditor ID",
        "tooltip": "Unique identifier for SEPA direct debits (request from your bank)",
        "placeholder": "e.g., ES98ZZZ12345678"
      },
      "facturacion": {
        "label": "Invoice Numbering",
        "tooltip": "Numbering format for invoices (e.g., INV-2024-)",
        "placeholder": "If blank, we start at 0"
